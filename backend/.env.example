# Copy to .env (optional). Defaults work out of the box with SQLite + a JSONL audit file.
DATABASE_URL=sqlite:///./adaptive.db
# DATABASE_URL=postgresql+psycopg2://aac:aac_pass@localhost:5432/aac
MONGO_URL=mongodb://localhost:27017
SECRET_KEY=change-this-to-a-long-random-string-at-least-32-chars
ENABLE_SIMULATION=1
BLACKLISTED_IPS=203.0.113.66
DEFAULT_COUNTRY=IN
