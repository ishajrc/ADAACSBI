# Copy to backend/.env (loaded automatically). Defaults work out of the box with SQLite + a JSONL audit file.
DATABASE_URL=sqlite:///./adaptive.db
# DATABASE_URL=postgresql+psycopg2://aac:aac_pass@localhost:5432/aac
MONGO_URL=mongodb://localhost:27017

# --- Demo mode (default) ---
ENABLE_SIMULATION=1

# --- Real mode: set simulation to 0 and use a long random secret ---
# ENABLE_SIMULATION=0
# SECRET_KEY=paste-a-long-random-string-here
# TRUSTED_PROXIES=127.0.0.1,10.0.0.0/8
# GEOIP_DB_PATH=geoip/GeoLite2-Country.mmdb
# GEO_ONLINE_FALLBACK=1
BLACKLISTED_IPS=203.0.113.66
DEFAULT_COUNTRY=IN
